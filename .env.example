# Copy to .env.local and fill in. Never commit .env.local.

# Auth0 SPA application (Auth0 Dashboard > Applications)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# Auth0 API identifier (Auth0 Dashboard > Applications > APIs)
VITE_AUTH0_AUDIENCE=https://cartpilot-api

# Ports
PORT=5173
API_PORT=3001

# Server-only secrets (never prefix with VITE_):
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest   (optional)
# GEMINI_THINKING=low                                 (optional)
TINYFISH_API_KEY=
